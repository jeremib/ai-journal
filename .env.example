# --- Auth (Auth.js) ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <your-origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Required when running behind a proxy / on a custom host in production
# AUTH_TRUST_HOST=true
# Optional: comma-separated allowlist of emails that may sign in
# ALLOWED_EMAILS=you@example.com

# --- AI chat (Anthropic) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# --- Optional server-side transcription (any OpenAI-compatible Whisper endpoint) ---
# Without this, recordings are transcribed live in the browser (where supported) and editable by hand.
# Groq has a free tier and is OpenAI-compatible (key: https://console.groq.com/keys):
#   TRANSCRIBE_API_URL=https://api.groq.com/openai/v1
#   TRANSCRIBE_MODEL=whisper-large-v3-turbo
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_API_URL=https://api.openai.com/v1
# TRANSCRIBE_MODEL=whisper-1
# Files above this size skip transcription (provider upload cap; Groq's free tier
# rejects over 25MB). The recording is still saved and the UI explains why it was
# not transcribed.
# TRANSCRIBE_MAX_MB=24

# --- Storage ---
# DATA_DIR=./data          # SQLite database + uploaded media
# MAX_UPLOAD_MB=200
